{
  "name": "webrtc-website",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open --hmr --proxy-config=proxy.conf.json",
    "build": "ng build --delete-output-path=false --extract-licenses=false",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:api": "tsc --project ./tsconfig.api.json --watch",
    "build:api": "tsc --project ./tsconfig.api.json",
    "build:all": "npm run clean && npm run build && npm run build:api",
    "clean": "rimraf dist/api dist/browser -g",
    "eslint": "cross-env COMMITLINT=1 eslint ./ --fix --cache --cache-location .eslintcache",
    "eslint:no-fix": "cross-env COMMITLINT=1 eslint ./ --cache --cache-location .eslintcache",
    "postinstall": "husky install"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.1.4",
    "@angular/common": "^19.1.4",
    "@angular/compiler": "^19.1.4",
    "@angular/core": "^19.1.4",
    "@angular/forms": "^19.1.4",
    "@angular/platform-browser": "^19.1.4",
    "@angular/platform-browser-dynamic": "^19.1.4",
    "@angular/router": "^19.1.4",
    "@ngrx/store": "^19.0.1",
    "copy-to-clipboard": "^3.3.3",
    "dayjs": "^1.11.13",
    "lodash-es": "^4.17.21",
    "ng-zorro-antd": "^19.0.2",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.1.5",
    "@angular/cli": "^19.1.5",
    "@angular/compiler-cli": "^19.1.4",
    "@babel/eslint-parser": "^7.26.5",
    "@sweet-milktea/babel-preset-sweet": "^4.4.0",
    "@types/jasmine": "^5",
    "@types/lodash-es": "^4",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "commitizen": "^4.3.1",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.19.0",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jasmine-core": "^5.5.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "lint-staged": "^15.4.3",
    "next": "^15.1.6",
    "rimraf": "^6.0.1",
    "typescript": "5.7.3"
  },
  "lint-staged": {
    "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "cross-env COMMITLINT=1 eslint --cache --cache-location .eslintcache --no-warn-ignored"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}